rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // SETUPS Rules
    match /setups/{setupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(incoming().userId) && isValidSetup(incoming());
      allow update: if isSignedIn() && isOwner(existing().userId) && isValidSetup(incoming());
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }

    function isValidSetup(data) {
      return data.userId is string &&
             data.dayType is string &&
             data.imageURL is string &&
             (!('suggestedEntry' in data) || data.suggestedEntry is number) &&
             (!('suggestedStop' in data) || data.suggestedStop is number) &&
             (!('suggestedTarget' in data) || data.suggestedTarget is number);
    }

    // TRADES Rules
    match /trades/{tradeId} {
      allow read: if isSignedIn() && isOwner(resource.data.userId); // Enforce ownership on read
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid; // Secure list queries
      allow create: if isSignedIn() && isOwner(incoming().userId) && isValidTrade(incoming());
      allow update: if isSignedIn() && isOwner(existing().userId) && (
        // Action: Update Status
        (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'exitPrice', 'pnl', 'updatedAt', 'notes', 'exitReason'])) && 
        isValidTrade(incoming())
      );
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }

    function isValidTrade(data) {
      return data.userId is string &&
             data.direction in ['LONG', 'SHORT'] &&
             data.entryPrice is number &&
             data.status in ['OPEN', 'CLOSED', 'CANCELLED', 'EXECUTED', 'MISSED', 'SUCCESSFUL', 'FAILED'] &&
             data.timestamp is number &&
             (!('screenshotUrl' in data) || data.screenshotUrl is string);
    }
  }
}
