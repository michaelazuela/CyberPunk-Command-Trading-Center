{
  "entities": {
    "Trade": {
      "title": "Trade",
      "description": "A recorded trade with outcome and screenshot reference.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "direction": { "type": "string", "enum": ["LONG", "SHORT"] },
        "dayType": { "type": "string" },
        "entryPrice": { "type": "number" },
        "exitPrice": { "type": "number" },
        "stopPrice": { "type": "number" },
        "targetPrice": { "type": "number" },
        "contracts": { "type": "number" },
        "pnl": { "type": "number" },
        "status": { "type": "string", "enum": ["OPEN", "CLOSED", "CANCELLED", "EXECUTED", "MISSED", "SUCCESSFUL", "FAILED"] },
        "exitReason": { "type": "string" },
        "notes": { "type": "string" },
        "timestamp": { "type": "number" },
        "screenshotUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "direction", "entryPrice", "status", "timestamp"]
    },
    "Setup": {
      "title": "Setup",
      "description": "A chart analysis setup with screenshot and AI reasoning.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "dayType": { "type": "string" },
        "reasoning": { "type": "string" },
        "confidence": { "type": "number" },
        "imageURL": { "type": "string" },
        "tags": { "type": "array" },
        "suggestedEntry": { "type": "number" },
        "suggestedStop": { "type": "number" },
        "suggestedTarget": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "dayType", "imageURL"]
    }
  },
  "firestore": {
    "setups/{setupId}": {
      "schema": "Setup",
      "description": "Collection of chart analysis setups."
    },
    "trades/{tradeId}": {
      "schema": "Trade",
      "description": "Collection of historical trades."
    }
  }
}
