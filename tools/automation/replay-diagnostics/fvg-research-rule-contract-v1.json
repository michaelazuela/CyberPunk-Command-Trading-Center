      "binding": "12_45_15m_parent_fvg_13_00_continuation_acceptance_not_parent_creation"
    },
    {
      "date": "2026-01-21",
      "status": "valid_rule_based_trade",
      "binding": "15m_fvg_hold_nested_5m_fvg_defense_continuation"
    },
    {
      "date": "2026-01-22",
      "status": "valid_fvg_stack_defense_long_story_late_shorts_invalid",
      "binding": "15m_fvg_stack_defense_continuation"
    }
  ]
}
