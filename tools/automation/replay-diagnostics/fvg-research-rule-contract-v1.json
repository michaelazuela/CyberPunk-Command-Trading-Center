{
  "version": "fvg-research-rule-contract-v1",
  "boundary": "research_only_no_live_scanner_discord_supabase_or_trading_rule_change",
  "modelLane": "FairValueGapResearchModel",
  "portableGuardrail": "tools/automation/replay-diagnostics/fvg-research-guardrails-v1.md",
  "mandatoryWorkflow": [
    "build_htf_15m_story_first",
    "identify_parent_fvg_failed_fvg_or_fvg_stack",
    "lock_parent_timestamp_to_15m_fvg_creation_not_later_continuation_candle",
    "classify_continuation_failure_balance_or_obstacle",
    "drill_to_5m_only_after_15m_story_is_valid",
    "require_completed_5m_proof",
    "anchor_stop_to_nearest_protected_5m_structure",
    "calculate_t1_t2_from_actual_entry_stop_risk",
    "treat_liquidity_open_fvg_htf_reaction_and_balanced_path_as_management_context"
  ],
  "parentSetupAuthority": "15M",
  "parentTimestampDiscipline": "Parent time is the 15M candle/formation that created the FVG zone. Later candles that trade through, reject, expand away from, or confirm the zone are proof or continuation context, not the parent.",
  "executionAuthority": "5M",
  "htfRole": "map_support_obstacle_draw_caution_only",
  "runtimeTouched": false,
  "rules": [
    {
      "name": "15M FVG Hold + Nested 5M FVG Defense Continuation",
      "type": "continuation",
      "requiredFacts": [
        "valid_15m_parent_fvg",
        "price_returns_into_15m_parent_fvg",
        "nested_or_aligned_5m_fvg_or_wick_defense_inside_parent",
        "completed_5m_defense",
        "entry_nearest_protected_5m_stop_t1_t2_known",
        "target_room_after_proof"
      ],
      "invalidations": [
        "no_valid_15m_parent_fvg",
        "5m_proof_outside_parent_context",
        "acceptance_through_fvg_against_trade_before_proof",
        "missing_protected_5m_stop",
        "targets_reached_before_proof"
      ]
    },
    {
      "name": "15M FVG Failure / Breakdown Continuation",
      "type": "failure_continuation",
      "requiredFacts": [
        "valid_15m_parent_fvg",
        "acceptance_through_parent_fvg_against_original_side",
        "pullback_or_rejection_into_failed_fvg_or_aligned_5m_area",
        "completed_5m_continuation_proof",
        "nearest_protected_5m_structure_stop",
        "t1_t2_from_actual_risk"
      ],
      "invalidations": [
        "no_valid_15m_parent_fvg",
        "no_acceptance_or_failure_through_parent",
        "no_completed_5m_rejection_or_continuation_proof",
        "target_room_already_delivered_before_proof"
      ]
    },
    {
      "name": "15M FVG Stack Defense Continuation",
      "type": "stack_defense_continuation",
      "requiredFacts": [
        "htf_15m_story_supports_continuation_or_no_accepted_reversal",
        "same_side_15m_fvg_stack_exists",
        "price_passes_through_first_fvg_in_stack",
        "final_last_valid_same_side_15m_fvg_defends",
        "completed_5m_proof_confirms_continuation",
        "entry_nearest_protected_5m_stop_t1_t2_known"
      ],
      "invalidations": [
        "no_valid_15m_fvg_stack",
        "price_accepts_through_final_defended_fvg",
        "opposite_side_completed_5m_proof_after_acceptance_through_final_defended_fvg",
        "missing_protected_5m_stop",
        "target_room_gone_before_proof"
      ],
      "antiDrift": [
        "do_not_classify_late_opposite_side_row_against_defended_final_15m_fvg_stack",
        "opposite_side_requires_accepted_break_through_final_defended_fvg_plus_completed_5m_proof"
      ]
    },
    {
      "name": "Balanced Path To Liquidity / Open FVG Objective",
      "type": "management_context",
      "requiredFacts": [
        "valid_fvg_candidate_already_exists",
        "first_real_liquidity_or_open_fvg_objective_ahead",
        "fvg_objectives_separate_from_real_liquidity",
        "balanced_or_rebalanced_path_between_entry_and_objective",
        "no_opposing_fvg_defends_before_delivery"
      ],
      "invalidations": [
        "used_as_standalone_trigger",
        "fvg_objective_mislabeled_as_liquidity",
        "opposing_fvg_or_htf_obstacle_defends_before_delivery",
        "objective_reached_before_entry"
      ]
    },
    {
      "name": "Opposing FVG Obstacle Before T1",
      "type": "obstacle_filter",
      "requiredFacts": [
        "opposing_fvg_or_htf_reaction_zone_between_entry_and_t1",
        "price_reaches_obstacle_after_proof",
        "obstacle_defends_before_t1_or_first_objective"
      ],
      "meaning": "A defended opposing FVG before T1 can downgrade or fail continuation. FVG obstacle priority comes before a simple liquidity ladder."
    }
  ],
  "antiDriftLanguage": {
    "doNotCallFvgLiquidity": true,
    "valid15mParentRequired": true,
    "doNotDriftParentTimestampForward": true,
    "ruleMatchesAreNotHumanReviewExceptions": true,
    "htfIsNotExecutionAuthority": true,
    "balancedPathIsNotTrigger": true,
    "startWithHtf15mStoryNotRaw5mRows": true,
    "defendedFinalFvgStackBlocksOppositeSideWithoutAcceptedBreakAnd5mProof": true,
    "unclearFactsBecomeDiagnosticOnly": true
  },
  "reviewedCaseBindings": [
    {
      "date": "2026-01-07",
      "status": "mixed",
      "binding": "opposing_fvg_obstacle_before_t1_and_afternoon_failure_diagnostic"
    },
