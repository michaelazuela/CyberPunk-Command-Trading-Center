# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_AUTH_REDIRECT_URL: The OAuth redirect URL.
# Set this to your deployed app URL (e.g., https://cyberpunk-command-trading-center.pages.dev)
# If empty, the app falls back to window.location.origin
VITE_AUTH_REDIRECT_URL="https://cyberpunk-command-trading-center.pages.dev"

# Supabase configuration
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Discord alert automation
# Local-only secret used by npm run nt:discord-alerts.
# Put the real webhook in .env.local, never in committed code.
DISCORD_WEBHOOK_URL=""

# Discord outcome buttons
# Used by the local scheduler to sign button URLs and by Cloudflare /api/discord-outcome to verify clicks.
# Use a long random string. Keep the same value locally and in Cloudflare.
DISCORD_OUTCOME_SECRET=""
# Optional during secret rotation. Keep the previous outcome secret here until old Discord buttons expire.
DISCORD_OUTCOME_SECRET_PREVIOUS=""

# Public deployed app URL used to build Discord button links.
# Example: https://cyberpunk-command-trading-center.pages.dev
DISCORD_OUTCOME_BASE_URL=""

# Server-only Supabase settings for Discord button callbacks.
# SUPABASE_SERVICE_ROLE_KEY must only be set in .env.local and Cloudflare secrets, never in browser Vite vars.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Supabase auth user id that owns Discord-created RAG rows.
# This lets your logged-in app retrieve the rows through normal user-scoped learning.
DISCORD_RAG_USER_ID=""

# Discord research review publisher
# Dedicated bot/channel for advisory-only research sample review. Do not reuse trade alert webhook secrets.
RESEARCH_REVIEW_DISCORD_BOT_TOKEN=""
RESEARCH_REVIEW_DISCORD_CHANNEL_ID=""
RESEARCH_REVIEW_DISCORD_GUILD_ID=""
RESEARCH_REVIEW_DISCORD_ALLOWED_USER_IDS=""
RESEARCH_REVIEW_STATE_PATH="tools/automation/research-review-packs/discord-review-state.json"
RESEARCH_REVIEW_DISCORD_PUBLIC_KEY=""
RESEARCH_REVIEW_DISCORD_APPLICATION_ID=""
RESEARCH_REVIEW_INTERACTION_PORT="8787"
